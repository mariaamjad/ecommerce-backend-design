          cx="12"
          cy="12"
          r="9"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        />
        <path
          d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
        />
      </symbol>
      <symbol id="i-headset" viewBox="0 0 24 24">
        <path
