      <symbol id="i-home" viewBox="0 0 24 24">
        <path
          d="M4 11.2 12 4l8 7.2M7 10.5V20h10v-9.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </symbol>
      <symbol id="i-list-bullets" viewBox="0 0 24 24">
        <path
          d="M10 6h10M10 12h10M10 18h10M5.5 6h.01M5.5 12h.01M5.5 18h.01"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </symbol>
      <symbol id="i-box" viewBox="0 0 24 24">
        <path
          d="M5 7.5 12 4l7 3.5v9L12 20l-7-3.5zm7-3.5v8m7-4.5-7 4-7-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
