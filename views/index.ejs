          <a href="#" class="mobile-source-link mobile-only">Source now <span>&rarr;</span></a>
        </section>

        <section class="category-panel card">
          <div class="promo promo-tech">
            <div class="promo-copy">
              <h2>Consumer electronics and gadgets</h2>
              <a href="#" class="ghost-button">Source now</a>
            </div>
          </div>

          <div class="mini-grid">
            <article class="mini-product">
              <div>
