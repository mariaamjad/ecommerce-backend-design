          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </symbol>
    </svg>

    <div class="mobile-drawer-backdrop mobile-only" data-mobile-close></div>
    <aside class="mobile-drawer mobile-only" aria-label="Mobile navigation">
      <div class="mobile-drawer-head">
        <div class="mobile-drawer-avatar"></div>
        <p>Sign in | Register</p>
        <button class="mobile-drawer-close" type="button" data-mobile-close aria-label="Close menu">&times;</button>
      </div>
      <div class="mobile-drawer-section">
        <nav class="mobile-drawer-nav">
          <a href="/"><svg><use href="#i-home"></use></svg><span>Home</span></a>
          <a href="/products"><svg><use href="#i-list-bullets"></use></svg><span>Categories</span></a>
          <a href="#"><svg><use href="#i-heart"></use></svg><span>Favorites</span></a>
          <a href="#"><svg><use href="#i-box"></use></svg><span>My orders</span></a>
        </nav>
      </div>
      <div class="mobile-drawer-section">
        <div class="mobile-drawer-links">
          <a href="#"><svg><use href="#i-globe-outline"></use></svg><span>English | USD</span></a>
          <a href="#"><svg><use href="#i-headset"></use></svg><span>Contact us</span></a>
          <a href="#"><svg><use href="#i-building"></use></svg><span>About</span></a>
        </div>
      </div>
      <div class="mobile-drawer-section">
        <div class="mobile-drawer-legal">
          <a href="#">User agreement</a>
          <a href="#">Partnership</a>
          <a href="#">Privacy policy</a>
        </div>
      </div>
    </aside>

    <header class="mobile-home-header mobile-only">
      <div class="mobile-top-row">
        <button class="mobile-menu-button" type="button" data-mobile-open aria-label="Open menu">
          <svg><use href="#i-menu"></use></svg>
        </button>
        <a class="brand" href="/">
          <img src="/assets/logo-colored.jpg" alt="Brand logo" />
        </a>
        <div class="mobile-icon-links">
          <a class="mobile-icon-button" href="/cart" aria-label="My cart"><svg><use href="#i-cart"></use></svg></a>
          <a class="mobile-icon-button" href="#" aria-label="Profile"><svg><use href="#i-user"></use></svg></a>
        </div>
      </div>
      <form class="mobile-search-bar" action="/products" method="GET">
        <svg><use href="#i-search"></use></svg>
        <input type="search" name="search" placeholder="Search" value="<%= search || '' %>">
      </form>
      <div class="mobile-chip-strip">
        <a class="mobile-chip" href="#">All category</a>
        <a class="mobile-chip" href="#">Gadgets</a>
        <a class="mobile-chip" href="#">Clothes</a>
        <a class="mobile-chip" href="#">Accessories</a>
      </div>
    </header>

    <header class="site-header">
      <div class="container topbar">
        <a class="brand" href="#">
          <img src="/assets/logo-colored.jpg" alt="Brand logo" />
        </a>

        <form class="search-bar" action="/products" method="GET">
          <input type="search"
          name="search" placeholder="Search"
          value="<%= search || '' %>" />

          <select name="category" aria-label="Select category">
            <option value="">All category</option>
            <option value="Automobiles">Automobiles</option>
            <option value="Clothes and wear">Clothes and wear</option>
            <option value="Home interiors">Home interiors</option>
            <option value="Computer and tech">Computer and tech</option>
            <option value="Tools, equipments">Tools, equipments</option>
            <option value="Sports and outdoor">Sports and outdoor</option>
            <option value="Animal and pets">Animal and pets</option>
            <option value="Tools, equipments">Machinery tools</option>
            <option value="Books">Other</option>
          </select>
          <button type="submit">Search</button>
        </form>

        <div class="header-tools">
          <a class="tool-link" href="#"
            ><svg><use href="#i-user"></use></svg><span>Profile</span></a
          >
          <a class="tool-link" href="#"
            ><svg><use href="#i-message"></use></svg><span>Message</span></a
          >
          <a class="tool-link" href="#"
            ><svg><use href="#i-heart"></use></svg><span>Orders</span></a
          >
          <a class="tool-link" href="/cart"
            ><svg><use href="#i-cart"></use></svg><span>My cart</span></a
          >
        </div>
      </div>

      <div class="nav-strip">
        <div class="container nav-row">
          <nav class="main-nav">
            <a href="/products" class="menu-trigger"
              ><svg><use href="#i-menu"></use></svg><span>All category</span></a
            >
            <a href="/products">Hot offers</a>
            <a href="#">Gift boxes</a>
            <a href="#">Projects</a>
            <a href="#">Menu item</a>
            <a href="#" class="nav-with-chevron"
              >Help <svg><use href="#i-chevron"></use></svg></a>
          </nav>

          <div class="nav-meta">
            <a href="#" class="nav-with-chevron"
              >English, USD <svg><use href="#i-chevron"></use></svg></a>
            <a href="#" class="ship-link"
              >Ship to <img src="/assets/germany.png" alt="Germany flag" /><svg>
                <use href="#i-chevron"></use></svg></a>
          </div>
        </div>
      </div>
    </header>

    <main class="page">
      <div class="container page-stack">
        <section class="hero card">
          <aside class="hero-menu">
            <a class="active" href="/products">Automobiles</a>
            <a href="/products?category=Clothes and wear">Clothes and wear</a>
            <a href="/products?category=Home interiors">Home interiors</a>
            <a href="/products?category=Computer and tech">Computer and tech</a>
            <a href="/products?category=Tools, equipments">Tools, equipments</a>
            <a href="/products?category=Sports and outdoor">Sports and outdoor</a>
            <a href="/products?category=Sports and outdoor">Animal and pets</a>
            <a href="/products?category=Tools, equipments">Machinery tools</a>
            <a href="/products?category=Books">More category</a>
          </aside>

          <div class="hero-banner">
            <div class="hero-copy">
              <p>Latest trending</p>
              <h1>Electronic items</h1>
              <a href="#" class="ghost-button">Learn more</a>
            </div>
          </div>

          <aside class="hero-side">
            <div class="user-card">
              <% if (user) { %>

                <div class="user-meta">
                  <div class="avatar"></div>
                  <p>
                    Hi, <%= user.name || "User" %><br />
                    Welcome back
                  </p>
                </div>
              
                <a href="/logout" class="primary-button">
                  Logout
                </a>
              
              <% } else { %>
              
                <div class="user-meta">
                  <div class="avatar"></div>
                  <p>
                    Hi, user<br />
                    let's get started
                  </p>
                </div>
              
                <a href="/signup" class="primary-button">
                  Join now
                </a>
                <a href="/login" class="secondary-button">
                  Log in
                </a>
              
              <% } %>
              <!-- <div class="user-meta">
                <div class="avatar"></div>
                <p>Hi, user<br />let's get stated</p>
              </div>
              <a href="#" class="primary-button">Join now</a>
              <a href="#" class="secondary-button">Log in</a> -->
            </div>

            <a href="#" class="side-offer side-offer-orange">
              Get US $10 off <br/> with a new <br/> supplier</a>
            <a href="#" class="side-offer side-offer-teal">
              Send quotes with <br/> supplier <br/> preferences</a>
          </aside>
        </section>

        <section class="offer-panel card">
