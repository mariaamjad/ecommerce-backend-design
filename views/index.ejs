        <section class="inquiry-banner">
          <div class="inquiry-copy">
            <h2>An easy way to send requests to all suppliers</h2>
            <p>
              Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do
              eiusmod tempor incididunt.
            </p>
            <a href="#" class="primary-button inquiry-mobile-button mobile-only">Send inquiry</a>
          </div>

          <form class="quote-card card" action="#">
            <h3>Send quote to suppliers</h3>
            <input type="text" placeholder="What item you need?" />
            <textarea rows="4" placeholder="Type more details"></textarea>
            <div class="quote-row">
              <input type="text" value="Quantity" aria-label="Quantity" />
              <select aria-label="Units">
                <option>Pcs</option>
              </select>
            </div>
            <button type="submit" class="primary-button">Send inquiry</button>
          </form>
        </section>

        <section class="content-section">
          <h2 class="section-title">Recommended items</h2>
          <div class="products-grid">
            <% products.forEach(product => { %>
              <article class="product-card card">
              <img src="<%= product.image %>" alt="<%= product.name %>" />
              <div>
                <strong>$<%= product.price %></strong>
                <p><%= product.name %></p>
              </div>
            </article>
            <% }); %>

            <!-- <article class="product-card card">
              <img src="/assets/tshirt-teal.jpg" alt="Teal t-shirt" />
              <div>
                <strong>$10.30</strong>
                <p>T-shirts with multiple colors, for men</p>
              </div>
            </article> -->
